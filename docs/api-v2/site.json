{
    "name": "Spark ORG",
    "apiVersion": "v2",
    "defaultLanguage": "zh-cn",
    "languages": [
        "en-us",
        "zh-cn"
    ],
    "endpoints": {
        "self": "/api/v2/schema.json",
        "openapi": "/api/v2/openapi.json",
        "guide": "/docs/api-guide.html",
        "site": "/api/v2/site.json",
        "news": "/api/v2/{lang}/news.json",
        "newsItem": "/api/v2/{lang}/news/{slug}.json",
        "contact": "/api/v2/{lang}/contact.json",
        "contactItem": "/api/v2/{lang}/contact/{slug}.json",
        "platform": "/api/v2/{lang}/platform.json",
        "platformItem": "/api/v2/{lang}/platform/{slug}.json",
        "search": "/api/v2/{lang}/search.json",
        "v1": "/api/v1/",
        "authLogin": "/api/v2/auth/login",
        "authLogin2fa": "/api/v2/auth/login/2fa",
        "authLogout": "/api/v2/auth/logout",
        "authSendCode": "/api/v2/auth/register/send-code",
        "authRegister": "/api/v2/auth/register",
        "authCheckUsername": "/api/v2/auth/check-username",
        "authPasswordSendCode": "/api/v2/auth/password/send-code",
        "authPasswordReset": "/api/v2/auth/password/reset",
        "authDeviceCode": "/api/v2/auth/device/code",
        "authDeviceToken": "/api/v2/auth/device/token",
        "authWebauthnBegin": "/api/v2/auth/webauthn/begin",
        "authWebauthnFinish": "/api/v2/auth/webauthn/finish",
        "oauthProviders": "/api/v2/oauth/providers.json"
    },
    "authenticated": {
        "userSearch": "/api/v2/{lang}/user-search.json",
        "userProfile": "/api/v2/{lang}/user/{username}.json",
        "authToken": "/api/v2/auth/token",
        "meTokens": "/api/v2/me/tokens.json",
        "meTokenCreate": "/api/v2/me/tokens",
        "meTokenRevoke": "/api/v2/me/tokens/{id}/revoke",
        "me": "/api/v2/me.json",
        "meUpdate": "/api/v2/me",
        "meEmailSendCode": "/api/v2/me/email/send-code",
        "meEmailVerify": "/api/v2/me/email/verify",
        "meSudoStatus": "/api/v2/me/sudo.json",
        "meSudoSendCode": "/api/v2/me/sudo/send-code",
        "meSudoVerify": "/api/v2/me/sudo/verify",
        "meSudoWebauthnBegin": "/api/v2/me/sudo/webauthn/begin",
        "meSudoWebauthnFinish": "/api/v2/me/sudo/webauthn/finish",
        "meTwofaLogin": "/api/v2/me/twofa/login",
        "mePgpSync": "/api/v2/me/pgp/sync",
        "meWebauthn": "/api/v2/me/webauthn.json",
        "meWebauthnRegisterBegin": "/api/v2/me/webauthn/register/begin",
        "meWebauthnRegisterFinish": "/api/v2/me/webauthn/register/finish",
        "meWebauthnDelete": "/api/v2/me/webauthn/delete",
        "contentSave": "/api/v2/{kind}/save",
        "contentDelete": "/api/v2/{kind}/{slug}/delete",
        "homeNews": "/api/v2/home-news.json",
        "homeNewsAdd": "/api/v2/home-news/add",
        "homeNewsRemove": "/api/v2/home-news/remove",
        "homeNewsReorder": "/api/v2/home-news/reorder",
        "users": "/api/v2/users.json",
        "userCreate": "/api/v2/users/create",
        "userPassword": "/api/v2/users/{username}/password",
        "userRole": "/api/v2/users/{username}/role",
        "userDelete": "/api/v2/users/{username}/delete",
        "history": "/api/v2/history.json",
        "historyRevert": "/api/v2/history/{id}/revert",
        "historyRevertEntry": "/api/v2/history/{id}/revert-entry",
        "tokens": "/api/v2/tokens.json",
        "tokenCreate": "/api/v2/tokens/create",
        "tokenRevoke": "/api/v2/tokens/{id}/revoke",
        "oauthIdentities": "/api/v2/oauth/identities.json",
        "oauthUnbind": "/api/v2/oauth/identities/unbind",
        "avatarUpload": "/api/v2/users/{username}/avatar",
        "avatarRemove": "/api/v2/users/{username}/avatar/delete",
        "settingsSave": "/api/v2/settings/save",
        "settingsForget": "/api/v2/settings/forget",
        "oauthClients": "/api/v2/oauth/clients.json",
        "oauthClientCreate": "/api/v2/oauth/clients/create",
        "oauthClientDelete": "/api/v2/oauth/clients/{id}/delete",
        "status": "/api/v2/status.json",
        "settings": "/api/v2/settings.json",
        "settingsSmtpTest": "/api/v2/settings/smtp/test",
        "settingsNtfyTest": "/api/v2/settings/ntfy/test",
        "searchAdmin": "/api/v2/search.json",
        "installBackups": "/api/v2/install/backups.json",
        "installBackupCreate": "/api/v2/install/backup",
        "installBackupDownload": "/api/v2/install/backup/{file}",
        "installReset": "/api/v2/install/reset"
    },
    "fieldSummary": {
        "news": {
            "index": [
                "slug",
                "date",
                "title",
                "url",
                "priority",
                "active"
            ],
            "full": [
                "slug",
                "date",
                "title",
                "desc",
                "url",
                "priority",
                "active",
                "place",
                "images"
            ],
            "indexPath": "/api/v2/{lang}/news.json",
            "itemPath": "/api/v2/{lang}/news/{slug}.json"
        },
        "contact": {
            "index": [
                "slug",
                "name",
                "title",
                "url",
                "priority"
            ],
            "full": [
                "slug",
                "name",
                "title",
                "url",
                "priority",
                "tel",
                "email",
                "homepage",
                "telExtra",
                "emailExtra",
                "social",
                "homepageExtra",
                "pgpFingerprint",
                "pgpKey"
            ],
            "indexPath": "/api/v2/{lang}/contact.json",
            "itemPath": "/api/v2/{lang}/contact/{slug}.json"
        },
        "platform": {
            "index": [
                "slug",
                "name",
                "desc",
                "url",
                "pageUrl",
                "priority"
            ],
            "full": [
                "slug",
                "name",
                "desc",
                "button",
                "url",
                "priority",
                "pageUrl"
            ],
            "indexPath": "/api/v2/{lang}/platform.json",
            "itemPath": "/api/v2/{lang}/platform/{slug}.json"
        }
    }
}
